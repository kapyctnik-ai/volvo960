@@ -0,0 +1,159 @@
+"""Regressions for the 2026-09-04 audit (docs/AUDIT_2026-09-04.md).
+
+None of these tests need the configurator workbook: the service is built with a
+dummy injected planner because every guarded path returns before planning.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from servermall_cpq.bot.handlers import _normalize_number, _parse_price, _parse_sku_and_price
+from servermall_cpq.new_path.service import (
+    NON_ENGLISH_INPUT,
+    NewPathCPQService,
+    contains_non_english,
+)
+from servermall_cpq.catalog.labels import parse_entry
+from servermall_cpq.parsing import TextRequestParser
+
+
+class _NoPlanner:
+    def plan(self, *args, **kwargs):  # pragma: no cover - must never be reached
+        raise AssertionError("planner must not run for guarded inputs")
+
+
+@pytest.fixture(scope="module")
+def service() -> NewPathCPQService:
+    return NewPathCPQService(planner=_NoPlanner())
+
+
+# --- #5 SFP28 media -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "media"),
+    [
+        ("2x 25GbE SFP28", "SFP28"),
+        ("2 x 25GbE SFP28, 128GB RAM", "SFP28"),
+        ("2x 10GbE SFP+", "SFP+"),
+        ("4x 1GbE RJ45", "RJ45"),
+    ],
+)
+def test_network_media_keeps_sfp28_distinct(text: str, media: str) -> None:
+    request = TextRequestParser().parse(text).request
+    assert request.network, text
+    assert request.network[0].media == media
+
+
+# --- #2 clarification answers are not new RFQs ------------------------------
+
+
+@pytest.mark.parametrize("answer", ["Dell R760", "256GB", "64 GB", "Xeon Gold 6430", "HPE"])
+def test_short_clarification_answers_are_not_full_rfqs(
+    service: NewPathCPQService, answer: str
+) -> None:
+    assert not service.looks_like_full_rfq(answer)
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "Dell T360 4LFF Condition New CPU Intel Xeon E-2488 RAM 64GB DDR5",
+        "Dell R760 8SFF NEW, 2x Xeon Gold 6430, 256GB DDR5 RAM",
+        "HPE DL380 Gen11, 4x 1.92TB SAS SSD RAID10",
+    ],
+)
+def test_real_rfqs_still_start_a_fresh_request(service: NewPathCPQService, text: str) -> None:
+    assert service.looks_like_full_rfq(text)
+
+
+# --- #4 price parsing --------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("1250", 1250.0),
+        ("1,250", 1250.0),
+        ("1 250", 1250.0),
+        ("1,250.00", 1250.0),
+        ("1.250,00", 1250.0),
+        ("12.50", 12.5),
+        ("12,50", 12.5),
+        ("$1 200", 1200.0),
+        ("1200 USD", 1200.0),
+        ("USD 180", 180.0),
+        ("180", 180.0),
+        ("Dell R760 8SFF, 2x Xeon 6430, 256GB RAM", None),
+        ("about 180", None),
+        ("0", None),
+    ],
+)
+def test_parse_price_only_accepts_price_shaped_messages(text: str, expected) -> None:
+    assert _parse_price(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("0W4CN 12.50", ("0W4CN", 12.5)),
+        ("PN: 0W4CN 12,50", ("0W4CN", 12.5)),
+        ("P10106-B21 1,250", ("P10106-B21", 1250.0)),
+        ("$1 200", (None, 1200.0)),
+        ("USD 180", (None, 180.0)),
+        ("Dell R760 8SFF, 2x Xeon 6430, 256GB RAM", (None, None)),
+    ],
+)
+def test_parse_sku_and_price(text: str, expected) -> None:
+    assert _parse_sku_and_price(text) == expected
+
+
+def test_normalize_number_rejects_ambiguous_separators() -> None:
+    assert _normalize_number("1,2,3") is None
+    assert _normalize_number("1.2.3") is None
+
+
+# --- #1 non-English input ----------------------------------------------------
+
+
+RUSSIAN_RFQ = "Нужен сервер Dell R760, 2 процессора Xeon 6430, 256 ГБ ОЗУ, 4 диска 1.92 ТБ SSD"
+
+
+def test_contains_non_english() -> None:
+    assert contains_non_english(RUSSIAN_RFQ)
+    assert not contains_non_english("Dell R760, 2x Xeon 6430, 256GB RAM")
+
+
+def test_russian_rfq_is_refused_instead_of_silently_reduced(service: NewPathCPQService) -> None:
+    result = service.process_text(RUSSIAN_RFQ)
+    assert result.unsupported_reason == NON_ENGLISH_INPUT
+    assert result.plan is None
+    assert not result.ready
+    assert "English" in (result.rendered_html or "")
+
+
+def test_russian_clarification_answer_is_refused(service: NewPathCPQService) -> None:
+    first = service.process_text("need a server")
+    assert first.question
+    second = service.apply_clarification(first.request_id, "для виртуализации")
+    assert second.unsupported_reason == NON_ENGLISH_INPUT
+
+
+# --- #5 catalog label: "2x25G" spells the speed without B ------------------
+
+
+@pytest.mark.parametrize(
+    ("label", "ports", "speed"),
+    [
+        ("Dell Mellanox ConnectX-4 CX422A Lx 2x25G SFP28 NDC", 2, 25),
+        ("(NEW) 2 ports 10/25GB SFP28 OCP3 (P10106-B21) Intel E810-XXVDA2", 2, 25),
+        ("Intel X710 DA4 4x10GB SFP+ Pcie", 4, 10),
+        ("Broadcom 5720 4x1GB NDC", 4, 1),
+    ],
+)
+def test_nic_label_speed_parses_g_and_gb_spellings(label: str, ports: int, speed: int) -> None:
+    parsed = parse_entry(["NIC Additional"], label)
+    assert parsed.category == "nic"
+    assert parsed.attrs.get("ports") == ports
+    assert parsed.attrs.get("speed_gb") == speed
