+        lambda match: f"{int(round(float(match.group(1)) * 1024))}GB",
+        text,
+    )
+    text = re.sub(r"(?i)\b(\d+)GB\s+(DDR-?\s*[345])\b(?!\s*(?:ram|memory|rdimm|lrdimm|udimm))", r"\1GB \2 RAM", text)
+    text = re.sub(r"(?i)\b(\d+)\s*GB\s+of\s+(?=ram\b|memory\b|ddr)", r"\1GB ", text)
     text = drop_fields_marked_as_none(text)
     text = re.sub(r"\s+", " ", text)
     return text.strip()
