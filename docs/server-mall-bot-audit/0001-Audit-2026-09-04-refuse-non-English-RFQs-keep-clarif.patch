+# AUDIT 2026-09-04 #4: price parsing. The old helpers replaced "," with "." and
+# grabbed the first number anywhere in the message, so "1,250" became 1.25 and a
+# new RFQ typed while a price was pending ("Dell R760 ... 256GB RAM") became a
+# 7608 USD purchase price. Confirmed prices go into the manager price journal,
+# which outranks the configurator workbook and has no undo, so a mis-parse
+# silently corrupts every later quote. Only price-shaped messages are accepted.
+_CURRENCY_NOISE = re.compile(r"(?i)(?:usd|eur|\$|€|per\s+unit|each)")
+_NUMBER_TOKEN = re.compile(r"^[+-]?\d[\d .,]*$")
+
+
+def _normalize_number(token: str) -> float | None:
+    """Parse 1250 / 1,250 / 1 250 / 1,250.00 / 1.250,00 / 12.50 / 12,50."""
+    token = token.strip().replace(" ", "")
+    if not token or not _NUMBER_TOKEN.match(token):
+        return None
+    if "," in token and "." in token:
+        decimal_sep = "," if token.rfind(",") > token.rfind(".") else "."
+        thousands_sep = "." if decimal_sep == "," else ","
+        token = token.replace(thousands_sep, "").replace(decimal_sep, ".")
+    elif "," in token:
+        head, _, tail = token.rpartition(",")
+        # "1,250" / "12,345,678" are thousands; "12,50" is a decimal.
+        if len(tail) == 3 and head.replace(",", "").isdigit():
+            token = token.replace(",", "")
+        elif token.count(",") == 1:
+            token = f"{head}.{tail}"
+        else:
+            return None
+    elif token.count(".") > 1:
+        head, _, tail = token.rpartition(".")
+        if len(tail) == 3 and head.replace(".", "").isdigit():
+            token = token.replace(".", "")
+        else:
+            return None
+    try:
+        value = float(token)
+    except ValueError:
         return None
-    value = float(match.group(0).replace(",", "."))
     return value if value > 0 else None
 
 
