+"""Regressions for the 2026-09-04 audit (docs/AUDIT_2026-09-04.md).
+
+None of these tests need the configurator workbook: the service is built with a
+dummy injected planner because every guarded path returns before planning.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from servermall_cpq.bot.handlers import _normalize_number, _parse_price, _parse_sku_and_price
+from servermall_cpq.new_path.service import (
+    NON_ENGLISH_INPUT,
+    NewPathCPQService,
+    contains_non_english,
+)
+from servermall_cpq.parsing import TextRequestParser
+
+
+class _NoPlanner:
+    def plan(self, *args, **kwargs):  # pragma: no cover - must never be reached
+        raise AssertionError("planner must not run for guarded inputs")
+
+
+@pytest.fixture(scope="module")
+def service() -> NewPathCPQService:
+    return NewPathCPQService(planner=_NoPlanner())
+
+
+# --- #5 SFP28 media -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "media"),
+    [
+        ("2x 25GbE SFP28", "SFP28"),
+        ("2 x 25GbE SFP28, 128GB RAM", "SFP28"),
+        ("2x 10GbE SFP+", "SFP+"),
+        ("4x 1GbE RJ45", "RJ45"),
+    ],
+)
+def test_network_media_keeps_sfp28_distinct(text: str, media: str) -> None:
+    request = TextRequestParser().parse(text).request
+    assert request.network, text
+    assert request.network[0].media == media
+
+
+# --- #2 clarification answers are not new RFQs ------------------------------
+
+
+@pytest.mark.parametrize("answer", ["Dell R760", "256GB", "64 GB", "Xeon Gold 6430", "HPE"])
+def test_short_clarification_answers_are_not_full_rfqs(
+    service: NewPathCPQService, answer: str
+) -> None:
+    assert not service.looks_like_full_rfq(answer)
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "Dell T360 4LFF Condition New CPU Intel Xeon E-2488 RAM 64GB DDR5",
+        "Dell R760 8SFF NEW, 2x Xeon Gold 6430, 256GB DDR5 RAM",
+        "HPE DL380 Gen11, 4x 1.92TB SAS SSD RAID10",
+    ],
+)
+def test_real_rfqs_still_start_a_fresh_request(service: NewPathCPQService, text: str) -> None:
+    assert service.looks_like_full_rfq(text)
+
+
+# --- #4 price parsing --------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("1250", 1250.0),
+        ("1,250", 1250.0),
+        ("1 250", 1250.0),
+        ("1,250.00", 1250.0),
+        ("1.250,00", 1250.0),
+        ("12.50", 12.5),
+        ("12,50", 12.5),
+        ("$1 200", 1200.0),
+        ("1200 USD", 1200.0),
+        ("USD 180", 180.0),
+        ("180", 180.0),
+        ("Dell R760 8SFF, 2x Xeon 6430, 256GB RAM", None),
+        ("about 180", None),
+        ("0", None),
+    ],
+)
+def test_parse_price_only_accepts_price_shaped_messages(text: str, expected) -> None:
+    assert _parse_price(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("0W4CN 12.50", ("0W4CN", 12.5)),
+        ("PN: 0W4CN 12,50", ("0W4CN", 12.5)),
+        ("P10106-B21 1,250", ("P10106-B21", 1250.0)),
+        ("$1 200", (None, 1200.0)),
+        ("USD 180", (None, 180.0)),
+        ("Dell R760 8SFF, 2x Xeon 6430, 256GB RAM", (None, None)),
+    ],
+)
+def test_parse_sku_and_price(text: str, expected) -> None:
+    assert _parse_sku_and_price(text) == expected
+
+
+def test_normalize_number_rejects_ambiguous_separators() -> None:
+    assert _normalize_number("1,2,3") is None
+    assert _normalize_number("1.2.3") is None
+
+
+# --- #1 non-English input ----------------------------------------------------
+
+
+RUSSIAN_RFQ = "Нужен сервер Dell R760, 2 процессора Xeon 6430, 256 ГБ ОЗУ, 4 диска 1.92 ТБ SSD"
+
+
+def test_contains_non_english() -> None:
+    assert contains_non_english(RUSSIAN_RFQ)
+    assert not contains_non_english("Dell R760, 2x Xeon 6430, 256GB RAM")
+
+
+def test_russian_rfq_is_refused_instead_of_silently_reduced(service: NewPathCPQService) -> None:
+    result = service.process_text(RUSSIAN_RFQ)
+    assert result.unsupported_reason == NON_ENGLISH_INPUT
+    assert result.plan is None
+    assert not result.ready
+    assert "English" in (result.rendered_html or "")
+
+
+def test_russian_clarification_answer_is_refused(service: NewPathCPQService) -> None:
+    first = service.process_text("need a server")
+    assert first.question
+    second = service.apply_clarification(first.request_id, "для виртуализации")
+    assert second.unsupported_reason == NON_ENGLISH_INPUT
+
+
+# --- handler level: #2 / #3 / #4 through the real aiogram FSM ----------------
+
+from aiogram.fsm.context import FSMContext  # noqa: E402
+from aiogram.fsm.storage.base import StorageKey  # noqa: E402
+from aiogram.fsm.storage.memory import MemoryStorage  # noqa: E402
+
+from servermall_cpq.bot import handlers  # noqa: E402
+from servermall_cpq.bot.handlers import ClarifyStates  # noqa: E402
+from servermall_cpq.config import Settings  # noqa: E402
+from servermall_cpq.new_path.service import NewPathResult  # noqa: E402
+
+
+class _FakeChat:
+    id = 1
+
+
+class _FakeMessage:
+    def __init__(self, text: str) -> None:
+        self.text = text
+        self.chat = _FakeChat()
+        self.message_id = 1
+        self.replies: list[str] = []
+
+    async def answer(self, text: str, **kwargs) -> None:
+        self.replies.append(text)
+
+
+def _state() -> FSMContext:
+    return FSMContext(
+        storage=MemoryStorage(), key=StorageKey(bot_id=1, chat_id=1, user_id=1)
+    )
+
+
+def _settings() -> Settings:
+    return Settings(TELEGRAM_BOT_TOKEN="test", CPQ_NEW_PATH_ENABLED="true")
+
+
+class _RecordingService:
+    """Stands in for NewPathCPQService; records which entry point was hit."""
+
+    def __init__(self, real: NewPathCPQService) -> None:
+        self.real = real
+        self.calls: list[tuple] = []
+
+    def looks_like_full_rfq(self, text: str) -> bool:
+        return self.real.looks_like_full_rfq(text)
+
+    def close(self, request_id: str) -> None:
+        self.calls.append(("close", request_id))
+
+    def process_text(self, text: str) -> NewPathResult:
+        self.calls.append(("process_text", text))
+        return NewPathResult(request_id="new-1", question="What is the workload?")
+
+    def apply_clarification(self, request_id: str, answer: str) -> NewPathResult:
+        self.calls.append(("apply_clarification", request_id, answer))
+        return NewPathResult(request_id=request_id, question="Second question?")
+
+    def apply_manual_price(self, request_id, component, price, *, sku=None) -> NewPathResult:
+        self.calls.append(("apply_manual_price", request_id, component, price, sku))
+        return NewPathResult(request_id=request_id, rendered_html="<b>ok</b>")
+
+
+async def test_new_rfq_while_price_pending_starts_fresh_request(service) -> None:
+    recorder = _RecordingService(service)
+    state = _state()
+    await state.set_state(ClarifyStates.waiting_for_price)
+    await state.update_data(request_id="old-1", pending_prices=["(NEW) 256GB DDR5 RDIMM"])
+    message = _FakeMessage("Dell R760 8SFF, 2x Xeon Gold 6430, 256GB DDR5 RAM")
+    await handlers.handle_manual_price(message, state, engine=None, settings=_settings(), new_path=recorder)
+    kinds = [call[0] for call in recorder.calls]
+    assert "apply_manual_price" not in kinds
+    assert "process_text" in kinds
+    assert (await state.get_data()).get("request_id") == "new-1"
+
+
+async def test_plain_price_while_pending_asks_for_confirmation(service) -> None:
+    recorder = _RecordingService(service)
+    state = _state()
+    await state.set_state(ClarifyStates.waiting_for_price)
+    await state.update_data(request_id="old-1", pending_prices=["(NEW) 256GB DDR5 RDIMM"])
+    message = _FakeMessage("1,250")
+    await handlers.handle_manual_price(message, state, engine=None, settings=_settings(), new_path=recorder)
+    assert recorder.calls == []
+    confirmation = (await state.get_data()).get("pending_price_confirmation")
+    assert confirmation and confirmation["price"] == 1250.0
+    assert "1250.00 EUR" in message.replies[-1]
+
+
+async def test_confirmed_price_reaches_service_with_sku(service) -> None:
+    recorder = _RecordingService(service)
+    state = _state()
+    await state.set_state(ClarifyStates.waiting_for_price)
+    await state.update_data(
+        request_id="old-1",
+        pending_prices=["pending:tray:dell:r760:sff:new"],
+        pending_price_confirmation={"component": "pending:tray:dell:r760:sff:new", "price": 12.5, "sku": "0W4CN"},
+    )
+    message = _FakeMessage("yes")
+    await handlers.handle_manual_price(message, state, engine=None, settings=_settings(), new_path=recorder)
+    assert recorder.calls[0] == ("apply_manual_price", "old-1", "pending:tray:dell:r760:sff:new", 12.5, "0W4CN")
+
+
+async def test_short_clarification_answer_goes_to_apply_clarification(service) -> None:
+    recorder = _RecordingService(service)
+    state = _state()
+    await state.set_state(ClarifyStates.waiting_for_answer)
+    await state.update_data(request_id="old-1", cpq_path="new")
+    message = _FakeMessage("Dell R760")
+    await handlers.handle_clarification_answer(message, state, engine=None, settings=_settings(), new_path=recorder)
+    assert recorder.calls == [("apply_clarification", "old-1", "Dell R760")]
+
+
+async def test_full_rfq_during_clarification_starts_fresh_request(service) -> None:
+    recorder = _RecordingService(service)
+    state = _state()
+    await state.set_state(ClarifyStates.waiting_for_answer)
+    await state.update_data(request_id="old-1", cpq_path="new")
+    message = _FakeMessage("Dell R760 8SFF, 2x Xeon Gold 6430, 256GB DDR5 RAM")
+    await handlers.handle_clarification_answer(message, state, engine=None, settings=_settings(), new_path=recorder)
+    assert [call[0] for call in recorder.calls] == ["close", "process_text"]
+
+
+# --- #27-#30 prose RFQs: number words, TB RAM, NIC dedupe, clause windows ------
+
+EMAIL_RFQ = (
+    "Hi, we need a quote for a Dell PowerEdge R760 with two Intel Xeon Gold 6430 "
+    "processors, 512 GB of DDR5 memory, eight 1.92 TB SAS SSDs in RAID 10, dual 25 GbE "
+    "SFP28 ports, redundant power supplies and rail kit. Thanks, John"
+)
+
+
+def test_prose_email_rfq_keeps_every_material_field() -> None:
+    request = TextRequestParser().parse(EMAIL_RFQ).request
+    assert request.cpu.cpu_count == 2
+    assert request.cpu.explicit_model == "Gold 6430"
+    assert request.ram.min_gb == 512
+    assert len(request.storage) == 1
+    pool = request.storage[0]
+    assert (pool.drive_count, pool.min_drive_capacity_gb, pool.media, pool.interface) == (
+        8, 1920, "SSD", "SAS"
+    )
+    assert pool.raid_level == "10"
+    assert [(n.ports, n.speed_gb, n.media) for n in request.network] == [(2, 25, "SFP28")]
+
+
+@pytest.mark.parametrize(
+    ("text", "count", "model"),
+    [
+        ("two Intel Xeon Gold 6430 processors", 2, "Gold 6430"),
+        ("2 processors Intel Xeon Gold 6430", 2, "Gold 6430"),
+        ("dual Intel Xeon Gold 6430", 2, "Gold 6430"),
+        ("two processors", 2, None),
+        ("dual-socket server, 128GB", 2, None),
+        ("cheapest dual-socket 2U server with 128GB RAM", 2, None),
+    ],
+)
+def test_cpu_count_from_words(text: str, count: int, model) -> None:
+    request = TextRequestParser().parse(text).request
+    assert request.cpu.cpu_count == count
+    assert request.cpu.explicit_model == model
+
+
+@pytest.mark.parametrize(
+    ("text", "gb"),
+    [("1 TB RAM", 1024), ("1TB DDR5", 1024), ("1.5TB of memory", 1536), ("2TB DDR5, 8x 7.68TB NVMe", 2048)],
+)
+def test_terabyte_memory_is_read(text: str, gb: int) -> None:
+    assert TextRequestParser().parse(text).request.ram.min_gb == gb
+
+
+def test_terabyte_memory_does_not_become_storage() -> None:
+    request = TextRequestParser().parse("2TB DDR5, 8x 7.68TB NVMe").request
+    assert [(p.drive_count, p.min_drive_capacity_gb) for p in request.storage] == [(8, 7680)]
+
+
+def test_network_requirement_is_not_duplicated() -> None:
+    request = TextRequestParser().parse("2 ports 25GbE SFP28").request
+    assert [(n.ports, n.speed_gb, n.media) for n in request.network] == [(2, 25, "SFP28")]
+
+
+def test_usable_pool_keeps_media_and_protocol_after_raid_level() -> None:
+    pool = TextRequestParser().parse("40TB usable RAID6 SAS HDD").request.storage[0]
+    assert (pool.min_usable_gb, pool.media, pool.interface, pool.raid_level) == (
+        40000, "HDD", "SAS", "6"
+    )
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "8x 1.92 TB SAS SSDs in RAID 10, 2x 25 GbE SFP28",
+        "8x 1.92 TB SAS SSDs, 2x 25 GbE SFP28 ports",
+        "8x 1.92 TB SAS SSDs in RAID 10. 2x 25 GbE SFP28 ports",
+    ],
+)
+def test_drive_pack_survives_a_following_nic_clause(text: str) -> None:
+    request = TextRequestParser().parse(text).request
+    assert [(p.drive_count, p.min_drive_capacity_gb) for p in request.storage] == [(8, 1920)]
+    assert [(n.ports, n.speed_gb) for n in request.network] == [(2, 25)]
