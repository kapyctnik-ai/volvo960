<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090A"
    android:orientation="vertical">

    <com.volvo960.obdctl.ui.dash.DashboardView
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B1113"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/textDashStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="#7FF2F4"
            android:textSize="12sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAutoFan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_fan_short"
            android:textColor="#7FF2F4"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonFanLow"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/fan_low_short"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonFanHigh"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/fan_high_short"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonResetTrip"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/trip_reset_short"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonControls"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/controls_short"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
